# Required to actually deliver job-application emails (see src/app/api/apply/route.ts).
# Without this set, applications are still safely logged to .data/applications.jsonl,
# but no email is sent. Get a key at https://resend.com — free tier is plenty for this.
RESEND_API_KEY=

# Optional — overrides the "from" address. dkns.ai is verified in Resend,
# so this defaults to careers@dkns.ai already; only set this to use a
# different sender.
# APPLICATIONS_FROM_EMAIL="DKNS Digital Careers <careers@dkns.ai>"
